{
  "examples": {
    "quickstart": {
      "source": "import 'package:chess_on_dart/chess_on_dart.dart';\n\nvoid main() {\n  final game = Game();\n  print('Legal moves: ${game.legalMoves.length}');\n\n  final move = Move.parseUCI('e2e4');\n  print('SAN: ${game.getMoveSAN(move)}');\n  game.tryMove(move);\n  print(game.toFEN());\n\n  game.undoMove(move);\n  print('Back at start: ${game.toFEN() == Game.startingPositionFen}');\n}\n",
      "output": "Legal moves: 20\nSAN: e4\nrnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1\nBack at start: true"
    },
    "notation": {
      "source": "import 'package:chess_on_dart/chess_on_dart.dart';\n\nvoid main() {\n  final game = Game();\n  // Loading a PGN replaces the game; it does not append moves.\n  game.loadPGN('1.e4 e5 2.Nf3 Nc6 3.Bb5 a6');\n  print(game.exportPGN());\n\n  final before = game.toFEN();\n  try {\n    game.loadFEN('not a position');\n  } on FormatException {\n    print('Invalid FEN left the game unchanged: ${game.toFEN() == before}');\n  }\n\n  final copy = cloneGame(game);\n  copy.tryMove(Move.parseUCI('b5a4'));\n  print('Original unchanged: ${game.toFEN() == before}');\n}\n",
      "output": "[Result \"*\"]\n[Event \"?\"]\n[Site \"?\"]\n[Date \"????.??.??\"]\n[Round \"?\"]\n[White \"?\"]\n[Black \"?\"]\n\n1. e4 e5 2. Nf3 Nc6 3. Bb5 a6 *\n\nInvalid FEN left the game unchanged: true\nOriginal unchanged: true"
    },
    "variants": {
      "source": "import 'package:chess_on_dart/chess_on_dart.dart';\n\nvoid main() {\n  final chess960 = Game()..loadFEN(chess960StartingFEN(0), Variant.chess960);\n  print('Chess960 #0: ${chess960.toFEN()}');\n\n  final hill = Game()\n    ..loadFEN('k7/8/8/8/8/3K4/8/8 w - - 0 1', Variant.kingOfTheHill);\n  hill.tryMove(Move.parseUCI('d3d4'));\n  print('King of the Hill: ${hill.status.name}');\n\n  final checks = Game()\n    ..loadFEN('4k3/8/8/8/8/8/8/3Q3K w - - 0 1 +2+0', Variant.threeCheck);\n  checks.tryMove(Move.parseUCI('d1e2'));\n  print('Three-Check: ${checks.variantState.checksGiven[0]} checks, '\n      '${checks.status.name}');\n}\n",
      "output": "Chess960 #0: bbqnnrkr/pppppppp/8/8/8/8/PPPPPPPP/BBQNNRKR w HFhf - 0 1\nKing of the Hill: variantWin\nThree-Check: 3 checks, variantWin"
    },
    "search": {
      "source": "import 'package:chess_on_dart/chess_on_dart.dart';\n\nint perft(Game game, int depth) {\n  if (depth == 0) return 1;\n  if (depth == 1) return game.legalMoves.length;\n  final moves = game.legalMoves;\n  var nodes = 0;\n  for (final move in moves) {\n    game.makeMoveFast(move);\n    try {\n      nodes += perft(game, depth - 1);\n    } finally {\n      game.undoMoveFast(move);\n    }\n  }\n  return nodes;\n}\n\nvoid main() {\n  final game = Game();\n  print('Depth 3: ${perft(game, 3)} nodes');\n  print('Position restored: ${game.toFEN() == Game.startingPositionFen}');\n}\n",
      "output": "Depth 3: 8902 nodes\nPosition restored: true"
    }
  },
